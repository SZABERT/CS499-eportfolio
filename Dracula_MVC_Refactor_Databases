import re
try:
    from pymongo import MongoClient
    from pymongo.errors import ConnectionFailure
except ImportError:
    print("PyMongo is not installed. Please run 'pip install pymongo' to continue.")
    exit()

class DatabaseManager:
    """Handles all MongoDB connections and queries."""
    def __init__(self):
        try:
            # Connect to local MongoDB instance
            self.client = MongoClient("mongodb://localhost:27017/", serverSelectionTimeoutMS=2000)
            self.client.admin.command('ping') # Test connection
            self.db = self.client['dracula_game']
            self.map_collection = self.db['map_data']
            self.save_collection = self.db['save_states']
            self.initialize_database()
        except ConnectionFailure:
            print("Failed to connect to MongoDB. Please ensure your local MongoDB server is running.")
            exit()

    def initialize_database(self):
        """Seeds the database with map data if it is empty."""
        if self.map_collection.count_documents({}) == 0:
            initial_rooms = [
                {"_id": "Foyer", "East": "Chapel", "Item": ""},
                {"_id": "Chapel", "North": "Groundskeeper's Quarters", "East": "Armory", "South": "Kitchen", "Item": "Holy Water"},
                {"_id": "Groundskeeper's Quarters", "South": "Chapel", "East": "Garage", "Item": "Wooden Stake"},
                {"_id": "Garage", "West": "Groundskeeper's Quarters", "Item": "Fuel"},
                {"_id": "Armory", "West": "Chapel", "North": "Dungeon", "Item": "Silver Bullets"},
                {"_id": "Kitchen", "East": "Study", "North": "Chapel", "Item": "Garlic Cloves"},
                {"_id": "Study", "West": "Kitchen", "Item": "Matches"},
                {"_id": "Dungeon", "Item": ""}
            ]
            self.map_collection.insert_many(initial_rooms)

    def get_room_data(self):
        """Retrieves the map data from MongoDB and formats it for the Model."""
        rooms = {}
        for document in self.map_collection.find():
            room_name = document["_id"]
            room_data = {k: v for k, v in document.items() if k != "_id"}
            rooms[room_name] = room_data
        return rooms

    def save_game(self, current_room, inventory, rooms_state):
        """Saves the player's current state to the database."""
        save_data = {
            "_id": "player_1",
            "current_room": current_room,
            "inventory": inventory,
            "rooms_state": rooms_state
        }
        # Upsert will update the existing save file or create a new one
        self.save_collection.update_one({"_id": "player_1"}, {"$set": save_data}, upsert=True)
        return True

    def load_game(self):
        """Loads the player's saved state from the database."""
        return self.save_collection.find_one({"_id": "player_1"})


class GameModel:
    """The Model handles data, state, and game logic."""
    def __init__(self, db_manager):
        self.db = db_manager
        # Load map from MongoDB instead of hardcoding
        self.rooms = self.db.get_room_data()
        self.inventory = []
        self.current_room = 'Foyer'
        self.total_items_needed = 6 

    def move_player(self, direction):
        if direction in self.rooms[self.current_room]:
            self.current_room = self.rooms[self.current_room][direction]
            return True
        return False

    def get_item(self, item_name):
        room_item = self.rooms[self.current_room].get('Item', '')
        if room_item.lower() == item_name.lower():
            self.inventory.append(room_item)
            self.rooms[self.current_room]['Item'] = ''
            return True
        return False

    def check_win_condition(self):
        return len(self.inventory) == self.total_items_needed
        
    def save_current_state(self):
        return self.db.save_game(self.current_room, self.inventory, self.rooms)
        
    def load_previous_state(self):
        save_data = self.db.load_game()
        if save_data:
            self.current_room = save_data["current_room"]
            self.inventory = save_data["inventory"]
            self.rooms = save_data["rooms_state"]
            return True
        return False

    def get_hint_bfs(self):
        needed_items = [
            room_data['Item'] for room_name, room_data in self.rooms.items() 
            if room_data.get('Item') != ''
        ]
        if not needed_items:
            return None, []

        queue = [(self.current_room, [])]
        visited = {self.current_room}

        while queue:
            current_node, path = queue.pop(0)
            node_item = self.rooms[current_node].get('Item', '')
            if node_item in needed_items and current_node != self.current_room:
                return node_item, path

            for key, value in self.rooms[current_node].items():
                if key != 'Item':
                    neighbor = value
                    if neighbor not in visited:
                        visited.add(neighbor)
                        queue.append((neighbor, path + [key]))

        return None, []


class GameView:
    """The View handles all terminal output and user input."""
    @staticmethod
    def print_separator():
        print('-' * 42)

    def display_introduction(self):
        print('Welcome to the Dracula Text Adventure Game!')
        self.print_separator()
        intro_text = """You are an experienced monster hunter, and you have fought your way through the
forest, defeating werewolves, lesser vampires, and other magical enemies to make
it to Dracula’s castle and defeat him once and for all and earn the renown of
defeating the worlds oldest and most powerful vampire! Through your fighting,
you’ve depleted your supplies. You will need to forage for more through the
castle before attempting to fight Dracula! You will start in the foyer. You will
need garlic cloves from the kitchen, a wooden stake from the groundskeeper’s
quarters, holy water from the chapel, silver bullets to reload your pistol
from the armory, fuel from the garage, and matches from the study to ignite the fuel
and burn the body after Dracula is defeated. Fortunately for you, it is the
daytime, and he is sleeping in his coffin in the dungeon, so you should be able
to move about the castle without disturbing him. However, if you should stumble
into the dungeon unprepared, he will wake up and suck your blood, turning you
into a vampire yourself!"""
        print(intro_text)
        self.print_separator()
        print('Commands: "Go [Direction]", "Get [Item]", "Hint", "Save", "Load", "Exit"')
        self.print_separator()

    def display_status(self, current_room, inventory, room_item):
        print(f'You are in the {current_room}')
        if not inventory:
            print('Your inventory is empty.')
        else:
            print(f'Your inventory contains: {", ".join(inventory)}')
        if room_item:
            print(f'In this room you see the {room_item}.')
        self.print_separator()

    def display_message(self, message):
        print(message)
        self.print_separator()

    def get_user_input(self):
        """Safely gets input and sanitizes it to prevent injection attacks."""
        try:
            raw_input = input('Enter your command: ').strip()
            # Security Enhancement: Strip all special characters, keep only letters and spaces
            sanitized_input = re.sub(r'[^a-zA-Z\s]', '', raw_input)
            return sanitized_input.split()
        except EOFError:
            return []


class GameController:
    """The Controller manages the game loop and orchestrates Model and View."""
    def __init__(self, model, view):
        self.model = model
        self.view = view
        self.is_running = True

    def run_game(self):
        self.view.display_introduction()

        while self.is_running:
            if self.model.current_room == 'Dungeon':
                self.handle_boss_encounter()
                break

            current_item = self.model.rooms[self.model.current_room].get('Item', '')
            self.view.display_status(self.model.current_room, self.model.inventory, current_item)

            command_parts = self.view.get_user_input()
            
            if not command_parts:
                self.view.display_message("Please enter a valid command. Special characters are ignored.")
                continue

            action = command_parts[0].capitalize()
            
            if action == 'Exit':
                self.view.display_message("Thank you for playing! Goodbye.")
                self.is_running = False

            elif action == 'Save':
                if self.model.save_current_state():
                    self.view.display_message("Game successfully saved to database.")

            elif action == 'Load':
                if self.model.load_previous_state():
                    self.view.display_message("Save file loaded from database.")
                else:
                    self.view.display_message("No save file found in database.")

            elif action == 'Hint':
                item, path = self.model.get_hint_bfs()
                if item:
                    path_string = ", then ".join(path)
                    self.view.display_message(f"Hint: The closest item is the {item}. Go {path_string}.")
                else:
                    self.view.display_message("You have found all the items. Head to the Dungeon!")

            elif action == 'Go' and len(command_parts) > 1:
                direction = command_parts[1].capitalize()
                if not self.model.move_player(direction):
                    self.view.display_message("You cannot go that way.")

            elif action == 'Get' and len(command_parts) > 1:
                item_name = " ".join(command_parts[1:]) 
                if self.model.get_item(item_name):
                    self.view.display_message(f"You got the {item_name.title()}.")
                else:
                    self.view.display_message("That item is not here.")
            else:
                self.view.display_message("Invalid command format.")

    def handle_boss_encounter(self):
        if self.model.check_win_condition():
            self.view.display_message('You douse him with holy water and win the game!')
        else:
            self.view.display_message('You stepped in unprepared. Game Over.')


if __name__ == "__main__":
    db = DatabaseManager()
    game_model = GameModel(db)
    game_view = GameView()
    controller = GameController(game_model, game_view)
    controller.run_game()